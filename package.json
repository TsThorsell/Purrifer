{
  "name": "purrifer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first economics control panel for documents, payments, and follow-up.",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "scripts\\dev.cmd",
